@model IEnumerable<CitasApp.Models.Medico>

@{
    ViewData["Title"] = "Médicos";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Listado de Médicos</h1>
        <a href="@Url.Action("Create", "Medico")" class="btn btn-success">+ Agregar Médico</a>
    </div>

    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Especialidad</th>
                <th>Número de Licencia</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var medico in Model)
            {
                <tr>
                    <td>@medico.Id</td>
                    <td>@medico.Nombre</td>
                    <td>@medico.Apellido</td>
                    <td>@medico.Especialidad</td>
                    <td>@medico.NumeroLicencia</td>
                    <td>
                        <a href="@Url.Action("Detalle", "Medico", new { id = medico.Id })" class="btn btn-sm btn-info">Ver Detalle</a>
                        <a href="@Url.Action("Edit", "Medico", new { id = medico.Id })" class="btn btn-sm btn-warning">Editar</a>
                        <form method="post" action="@Url.Action("Delete", "Medico")" style="display:inline;">
                            <input type="hidden" name="id" value="@medico.Id" />
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Está seguro?')">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
